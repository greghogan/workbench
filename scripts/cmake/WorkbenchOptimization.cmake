# Optional analysis and optimized variants share the selected compiler and dependency ABI.
set(WORKBENCH_PGO "off" CACHE STRING "Profile-guided optimization: off, generate, or use")
set_property(CACHE WORKBENCH_PGO PROPERTY STRINGS off generate use)
set(WORKBENCH_PGO_DIRECTORY "" CACHE PATH "Owned profile input/output directory")
option(WORKBENCH_STATIC_ANALYSIS "Run the selected compiler's additional analyzer" OFF)
option(WORKBENCH_HARDENING "Enable verified release protections" OFF)

function(workbench_optimization language)
  if(NOT WORKBENCH_PGO MATCHES "^(off|generate|use)$")
    message(FATAL_ERROR "WORKBENCH_PGO must select off, generate, or use")
  endif()
  if(WORKBENCH_STATIC_ANALYSIS)
    if(CMAKE_${language}_COMPILER_ID STREQUAL "GNU" AND language STREQUAL "C")
      add_compile_options(-fanalyzer)
    elseif(CMAKE_${language}_COMPILER_ID STREQUAL "MSVC")
      add_compile_options(/analyze /analyze:external-)
    else()
      message(FATAL_ERROR "Additional compiler analysis supports GCC C and mvsc C/C++; use clang-tidy for Clang")
    endif()
  endif()
  if(NOT WORKBENCH_PGO STREQUAL "off")
    if(WORKBENCH_COVERAGE OR WORKBENCH_SANITIZERS OR CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
      message(FATAL_ERROR "PGO requires a separate Release build without coverage or sanitizers")
    endif()
    if(NOT IS_ABSOLUTE "${WORKBENCH_PGO_DIRECTORY}")
      message(FATAL_ERROR "PGO requires an absolute owned profile directory")
    endif()
    if(CMAKE_${language}_COMPILER_ID STREQUAL "Clang")
      if(WORKBENCH_PGO STREQUAL "generate")
        add_compile_options(-fprofile-instr-generate)
        add_link_options(-fprofile-instr-generate)
      else()
        if(NOT EXISTS "${WORKBENCH_PGO_DIRECTORY}/merged.profdata")
          message(FATAL_ERROR "Requested Clang PGO profile is missing")
        endif()
        add_compile_options("-fprofile-instr-use=${WORKBENCH_PGO_DIRECTORY}/merged.profdata" -Werror=profile-instr-out-of-date)
        add_link_options("-fprofile-instr-use=${WORKBENCH_PGO_DIRECTORY}/merged.profdata")
      endif()
    elseif(CMAKE_${language}_COMPILER_ID STREQUAL "GNU")
      # Normalize object names so the independent generate/use trees can share profiles.
      add_compile_options("-fprofile-prefix-path=${CMAKE_BINARY_DIR}")
      if(WORKBENCH_PGO STREQUAL "generate")
        add_compile_options("-fprofile-generate=${WORKBENCH_PGO_DIRECTORY}")
        add_link_options("-fprofile-generate=${WORKBENCH_PGO_DIRECTORY}")
      else()
        file(GLOB_RECURSE profiles "${WORKBENCH_PGO_DIRECTORY}/*.gcda")
        if(NOT profiles)
          message(FATAL_ERROR "Requested GCC PGO profiles are missing")
        endif()
        add_compile_options("-fprofile-use=${WORKBENCH_PGO_DIRECTORY}" -Werror=missing-profile -Werror=coverage-mismatch)
        add_link_options("-fprofile-use=${WORKBENCH_PGO_DIRECTORY}")
      endif()
    else()
      message(FATAL_ERROR "This PGO workflow supports Clang and GCC; the selected compiler is unsupported")
    endif()
  endif()
  if(WORKBENCH_HARDENING)
    if(NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR WORKBENCH_COVERAGE OR WORKBENCH_SANITIZERS)
      message(FATAL_ERROR "Hardening verification requires a separate Release build")
    endif()
    include(CheckCompilerFlag)
    if(MSVC)
      check_compiler_flag(${language} "/GS /guard:cf" workbench_hardening_supported)
      if(NOT workbench_hardening_supported)
        message(FATAL_ERROR "The selected compiler cannot provide the requested Windows protections")
      endif()
      add_compile_options(/GS /guard:cf)
      add_link_options(/guard:cf /DYNAMICBASE /NXCOMPAT)
    elseif(NOT WIN32)
      check_compiler_flag(${language} "-fstack-protector-strong" workbench_hardening_supported)
      if(NOT workbench_hardening_supported)
        message(FATAL_ERROR "The selected compiler cannot provide stack protection")
      endif()
      add_compile_options(-fstack-protector-strong)
      if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_compile_options(-D_FORTIFY_SOURCE=3)
        add_link_options(-Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack)
      elseif(APPLE)
        add_compile_options(-D_FORTIFY_SOURCE=2)
        add_link_options(-Wl,-pie)
      endif()
    else()
      message(FATAL_ERROR "Windows hardening verification currently requires mvsc")
    endif()
  endif()
endfunction()
