;; Check the signed Guix file set without writing to the receiving store.
(use-modules (guix pki)
             (guix serialization)
             (gcrypt hash)
             (gcrypt pk-crypto)
             (ice-9 binary-ports)
             (ice-9 match)
             (rnrs bytevectors)
             (srfi srfi-11))

(define (fail format-string . arguments)
  (apply format (current-error-port) format-string arguments)
  (primitive-exit 1))

(define (read-file _ type content buffer)
  (when (memq type '(regular executable))
    (match content
      ((port . size)
       (let loop ((remaining size))
         (unless (zero? remaining)
           (let ((count (get-bytevector-n! port buffer 0
                                           (min remaining (bytevector-length buffer)))))
             (when (or (eof-object? count) (zero? count))
               (fail "Truncated Guix archive.~%"))
             (loop (- remaining count))))))))
  buffer)

(define (verify-item port acl buffer)
  (let-values (((item hash) (open-sha256-input-port port)))
    (fold-archive read-file buffer item "")
    (unless (= (read-int item) #x4558494e)
      (fail "Invalid Guix archive item.~%"))
    (let ((path (read-store-path item)))
      (read-store-path-list item)
      (read-string item)
      (let ((digest (hash)))
        (unless (= (read-int item) 1)
          (fail "Unsigned Guix archive item: ~a~%" path))
        (signature-case ((string->canonical-sexp (read-latin1-string item)) digest acl)
          (valid-signature #t)
          (else (fail "Invalid or unauthorized Guix archive signature: ~a~%" path)))))))

(let ((port (current-input-port))
      (acl (current-acl))
      (buffer (make-bytevector 65536)))
  (let loop ((seen? #f))
    (case (read-long-long port)
      ((0)
       (unless (and seen? (eof-object? (get-u8 port)))
         (fail "Empty Guix archive or trailing data.~%")))
      ((1)
       (verify-item port acl buffer)
       (loop #t))
      (else (fail "Invalid Guix archive item marker.~%")))))
