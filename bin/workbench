#!/usr/bin/env bash
set -euo pipefail

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
distribution_root=$(cd -- "$launcher_dir/.." && pwd -P)
if [[ "${distribution_root##*/}" == '.workbench' ]]; then
    project_root=$(cd -- "$distribution_root/.." && pwd -P)
else
    project_root=$distribution_root
fi

command -v node >/dev/null || {
    printf 'workbench: Node.js 22.12 or newer is required\n' >&2
    exit 1
}
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 12) ? 0 : 1)' || {
    printf 'workbench: Node.js 22.12 or newer is required\n' >&2
    exit 1
}
[[ -f "$distribution_root/bundle/main.cjs" ]] || {
    printf 'workbench: bundled application is missing: %s\n' "$distribution_root/bundle/main.cjs" >&2
    exit 1
}

exec env WORKBENCH_PROJECT_ROOT="$project_root" WORKBENCH_DISTRIBUTION_ROOT="$distribution_root" \
    node "$distribution_root/bundle/main.cjs" "$@"
