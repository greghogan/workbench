# Machine-local environment
.direnv/
.envrc.local

# Editor recovery files
*.swp
*.swo

# Build outputs and reports across language roots
build/
**/coverage/*
!**/coverage/coverage-summary.json
dist/
htmlcov/
target/

# Node.js / TypeScript dependencies and compiler state; node_modules may be a link
*.tsbuildinfo
.pnpm-store/
node_modules
.screen-reader-assets/

# Python dependencies and caches; virtual environments may be links
*.egg-info/
*.pyc
.coverage
.coverage.*
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv
.venv.workbench-backup
__pycache__/

# LLVM instrumentation
*.profdata
*.profraw

# Generated project skill links must remain visible even with a global .claude ignore.
!.claude/
.claude/*
!.claude/skills/

# Local citation documents; bibliographic records remain tracked.
/library/citations/

