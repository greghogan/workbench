test("source, command selection, environment, distribution, and CPU preferences invalidate success", async () => {
  const f = fixture();
  await f.run();
  const changes = [
    () => {
      writeFileSync(join(f.root, "source.txt"), "second source");
    },
    () =>
      required(
        required(f.plan.sessions[0], "Expected fixture value: f.plan.sessions[0]").checks[0],
        "Expected fixture value: f.plan.sessions[0].checks[0]",
      ).command.push("extra"),
    () => vi.stubEnv("WORKBENCH_CACHE_TEST_INPUT", "changed environment"),
    () => {
      writeFileSync(join(f.distribution, "new-helper.mjs"), "export const changed = true;");
    },
    () => {
      writeFileSync(join(f.root, "workbench/local.toml"), "[execution]\nmax_jobs=1\n");
    },
  ];
  for (const [index, change] of changes.entries()) {
    change();
    await f.run();
    await f.run();
    expect(f.executions()).toBe(index + 2);
  }
});

test("external command bytes invalidate the cache even when the project has not changed", async () => {
  const f = fixture();
  const command = join(f.base, "external-command");
  writeFileSync(command, "first executable bytes", { mode: 0o755 });
  required(
    required(f.plan.sessions[0], "Expected fixture value: f.plan.sessions[0]").checks[0],
    "Expected fixture value: f.plan.sessions[0].checks[0]",
  ).command = [command];
  await f.run();
  await f.run();
  expect(f.executions()).toBe(1);
  writeFileSync(command, "second executable bytes");
  await f.run();
  expect(f.executions()).toBe(2);
});

test("generated Python bytecode in an installed distribution does not invalidate successful checks", async () => {
  const f = fixture();
  await f.run();
  const bytecode = join(f.distribution, "scripts", "__pycache__");
  mkdirSync(bytecode);
  writeFileSync(join(bytecode, "bootstrap.cpython-311.pyc"), "generated bytecode");
  await f.run();
  expect(f.executions()).toBe(1);
  writeFileSync(join(f.distribution, "scripts", "bootstrap.py"), "changed source");
  await f.run();
  expect(f.executions()).toBe(2);
});

test("records, sidecars, maps, and generated summaries do not invalidate code evidence", async () => {
  const f = fixture();
  await f.run();
  const records = [
    "AGENTS.md",
    "workbench/CHARTER.md",
    "workbench/decision-map.md",
    "workbench/task-map.md",
    "workbench/source-map.md",
    "workbench/source-maps/records.md",
    "workbench/release-index.tsv",
    "workbench/decisions/ADR-00.md",
    "workbench/tasks/TSK-00.md",
    "workbench/experiments/EXP-00.md",
    "workbench/environments/ENV-00.md",
    "workbench/citations/CIT-00.json",
    "workbench/releases/REL-00.yaml",
    "workbench/experiments/EXP-00/evidence.json",
    "workbench/collections/company/decisions/ADR-00.md",
    "coverage/coverage-summary.json",
  ];
  for (const name of records) {
    mkdirSync(join(f.root, name, ".."), { recursive: true });
    writeFileSync(join(f.root, name), "project-owned material");
  }
  f.git("add", ".");
  await f.run();
  for (const name of records) writeFileSync(join(f.root, name), "updated material");
  await f.run();
  mkdirSync(join(f.distribution, "workbench/decisions"), { recursive: true });
  writeFileSync(join(f.distribution, "workbench/decisions/ADR-00.md"), "distribution policy");
  await f.run();
  expect(f.executions()).toBe(1);
  writeFileSync(join(f.distribution, "workbench-dependency.txt"), "runtime input");
  await f.run();
  expect(f.executions()).toBe(2);
});

test("subproject records are excluded while test-owned records and executable configuration remain inputs", () => {
  const f = fixture();
  writeFileSync(
    join(f.root, "workbench/projects.toml"),
    '[[project]]\nid="demo"\npath="."\n[[project]]\nid="api"\npath="api"\n',
  );
  const names = [
    "api/workbench/decisions/ADR-00/diagram.svg",
    "tests/fixtures/workbench/decisions/ADR-00.md",
    "workbench/quality.json",
  ];
  for (const name of names) {
    mkdirSync(join(f.root, name, ".."), { recursive: true });
    writeFileSync(join(f.root, name), "original");
  }
  const original = sourceFingerprint(f.root);
  writeFileSync(join(f.root, required(names[0], "Fixture value names[0]")), "new diagram");
  expect(sourceFingerprint(f.root)).toBe(original);
  for (const name of names.slice(1)) {
    writeFileSync(join(f.root, name), "changed input");
    expect(sourceFingerprint(f.root)).not.toBe(original);
    writeFileSync(join(f.root, name), "original");
  }
});

test("declared inputs reinclude record files, directories, and otherwise ignored files", async () => {
  const f = fixture();
  const config = join(f.root, "workbench/config.toml");
  writeFileSync(config, readFileSync(config, "utf8") + 'inputs=["workbench/experiments/EXP-00", "ignored-output"]\n');
  mkdirSync(join(f.root, "workbench/experiments/EXP-00"), { recursive: true });
  const input = join(f.root, "workbench/experiments/EXP-00/driver.py");
  writeFileSync(input, "original");
  await f.run();
  await f.run();
  expect(f.executions()).toBe(1);
  writeFileSync(input, "changed");
  await f.run();
  expect(f.executions()).toBe(2);
  writeFileSync(join(f.root, "ignored-output"), "explicitly included");
  await f.run();
  expect(f.executions()).toBe(3);
});

