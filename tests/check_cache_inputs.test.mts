  const f = fixture();
  await f.run();
  for (const name of [
    "CODEX_TOOL_CALL_ID",
    "CODEX_SESSION_ID",
    "CODEX_THREAD_ID",
    "UNRELATED_SESSION_ID",
    "DIRENV_DIFF",
    "DIRENV_WATCHES",
