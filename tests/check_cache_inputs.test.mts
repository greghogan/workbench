test.each(["checks", "environment", "tools", "allocation"])(
  "fingerprint diagnostics identify changed %s using digests only",
  (category) => {
    const f = fixture();
    const command = join(f.base, "external-command");
    writeFileSync(command, "first executable bytes", { mode: 0o755 });
    required(
      required(f.plan.sessions[0], "Expected fixture value: f.plan.sessions[0]").checks[0],
      "Expected fixture value: f.plan.sessions[0].checks[0]",
    ).command = [command];
    const before = checkFingerprint(f.root, {}, f.plan);
    if (category === "checks")
      required(
        required(f.plan.sessions[0], "Expected fixture value: f.plan.sessions[0]").checks[0],
        "Expected fixture value: f.plan.sessions[0].checks[0]",
      ).name = "Renamed check";
    if (category === "environment") vi.stubEnv("WORKBENCH_PRIVATE_INPUT", "must never appear in diagnostics");
    if (category === "tools") writeFileSync(command, "second executable bytes");
    if (category === "allocation")
      writeFileSync(join(f.root, "workbench/local.toml"), "[execution]\nmax_jobs=1\ncpus_per_job=1\n");
    const after = checkFingerprint(f.root, {}, f.plan);
    expect(after.key).not.toBe(before.key);
    expect(changedCheckInputs(before, after)).toContain(category);
    expect(JSON.stringify(after)).not.toContain("must never appear");
    for (const digest of [after.key, ...Object.values(after.components)]) expect(digest).toMatch(/^[a-f0-9]{64}$/);
    expect(changedCheckInputs(after, after)).toEqual([]);
  },
);

test.each(["added", "changed", "removed"])(
  "cache misses name %s environment inputs without exposing values",
  async (change) => {
    const f = fixture();
    const messages = vi.spyOn(console, "log");
    vi.stubEnv("WORKBENCH_PRIVATE_INPUT", change === "added" ? undefined : "first private value");
    await f.run();
    messages.mockClear();
    vi.stubEnv("WORKBENCH_PRIVATE_INPUT", change === "removed" ? undefined : "second private value");
    await f.run();
    expect(f.executions()).toBe(2);
    const output = messages.mock.calls.flat().join("\n");
    expect(output).toContain("Changed environment variables: WORKBENCH_PRIVATE_INPUT.");
    expect(output).not.toContain("private value");
    for (const entry of inspectBuildCache(f.root).entries.filter(({ kind }) => kind === "checks"))
      expect(readFileSync(join(entry.directory, "result.json"), "utf8")).not.toContain("private value");
  },
);

test.each([undefined, { "unsafe\nreceipt text": "a".repeat(64) }, { WORKBENCH_PRIVATE_INPUT: "private value" }])(
  "unavailable or invalid variable diagnostics retain category diagnostics without rendering receipt text",
  async (variables) => {
    const f = fixture();
    vi.stubEnv("WORKBENCH_PRIVATE_INPUT", "before");
    await f.run();
    const entry = required(
      inspectBuildCache(f.root).entries.find(({ kind }) => kind === "checks"),
      "Check receipt",
    );
    const path = join(entry.directory, "result.json");
    const saved = JSON.parse(readFileSync(path, "utf8")) as Record<string, unknown>;
    saved.environmentVariables = variables;
    writeFileSync(path, JSON.stringify(saved));
    const messages = vi.spyOn(console, "log");
    vi.stubEnv("WORKBENCH_PRIVATE_INPUT", "after");
    await f.run();
    expect(f.executions()).toBe(2);
    const output = messages.mock.calls.flat().join("\n");
    expect(output).toContain("Check cache miss: environment changed.");
    expect(output).not.toMatch(/Changed environment variables|unsafe|private value/);
  },
);
