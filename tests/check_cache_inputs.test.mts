const fixture = checkCacheFixtures();

test("check evidence fingerprints the resolved ordering graph and fixed per-session CPU budgets", () => {
  const f = fixture();
  const original = required(f.plan.sessions[0], "root session");
  const child = join(f.root, "child");
  mkdirSync(child);
  f.plan.sessions.push({
    ...original,
    directory: child,
    checks: original.checks.map((check) => ({ ...check, directory: child })),
  });
  original.checks.unshift({ ...required(original.checks[0], "fixture check"), name: "setup", role: "setup" });
  f.plan.automatic = true;
  const serial = checkFingerprint(f.root, {}, f.plan);
  f.plan.ordering = [{ root: "child", after: ".", phase: "setup" }];
  const overlap = checkFingerprint(f.root, {}, f.plan);
  expect(overlap.key).not.toBe(serial.key);
  expect(overlap.components.checks).not.toBe(serial.components.checks);
  expect(overlap.components.allocation).not.toBe(serial.components.allocation);
  f.plan.automatic = false;
  expect(checkFingerprint(f.root, {}, f.plan).key).toBe(serial.key);
});

test("working and staged content identities agree; untracked, deleted, executable, and edited inputs change identity", () => {
  const { root, base, git } = fixture();
  const snapshot = join(base, "snapshot");
  mkdirSync(snapshot);
  git("checkout-index", "--all", `--prefix=${snapshot}/`);
  const original = sourceFingerprint(root);
  expect(sourceFingerprint(snapshot, root, true)).toBe(original);
  writeFileSync(join(root, "ignored-output"), "ignored generated bytes");
  expect(sourceFingerprint(root)).toBe(original);
  writeFileSync(join(root, "extra.txt"), "untracked input");
  expect(sourceFingerprint(root)).not.toBe(original);
  rmSync(join(root, "extra.txt"));
  if (process.platform !== "win32") {
    chmodSync(join(root, "source.txt"), 0o755);
    expect(sourceFingerprint(root)).not.toBe(original);
    chmodSync(join(root, "source.txt"), 0o644);
  }
  rmSync(join(root, "source.txt"));
  const deleted = sourceFingerprint(root);
  expect(deleted).not.toBe(original);
  git("add", "-u");
  expect(sourceFingerprint(root)).toBe(deleted);
  writeFileSync(join(root, "source.txt"), "second source");
  expect(sourceFingerprint(root)).not.toBe(original);
});

