#!/usr/bin/env bash
set -euo pipefail

# Git prepends its helper directory for hooks. Restore the caller's tool selection
# so working-directory checks and staged checks use the same environment.
git_exec_path=$(git --exec-path)
if command -v cygpath >/dev/null 2>&1; then
    git_exec_path=$(cygpath -u "$git_exec_path")
fi
if [[ "${PATH:-}" == "$git_exec_path":* ]]; then
    export PATH="${PATH#"$git_exec_path":}"
fi

repository_root=$(git rev-parse --show-toplevel)
snapshot_owner=$(mktemp -d)
staged_snapshot="$snapshot_owner/source"
snapshot_index="$snapshot_owner/index"
staged_source=
trap 'rm -rf -- "$snapshot_owner"; if [[ -n "$staged_source" ]]; then rmdir -- "$staged_source"; fi' EXIT
mkdir -- "$staged_snapshot"
source_index=$(git -C "$repository_root" rev-parse --path-format=absolute --git-path index)
if [[ -f "$source_index" ]]; then
    cp -- "$source_index" "$snapshot_index"
else
    GIT_INDEX_FILE="$snapshot_index" git -C "$repository_root" read-tree --empty
fi
review_tree=$(GIT_INDEX_FILE="$snapshot_index" git -C "$repository_root" write-tree)
# Drop inherited worktree hints such as assume-unchanged before verifying the private checkout.
rm -f -- "$snapshot_index"
GIT_INDEX_FILE="$snapshot_index" git -C "$repository_root" read-tree --no-sparse-checkout "$review_tree"
GIT_INDEX_FILE="$snapshot_index" git -c core.symlinks=true -C "$repository_root" checkout-index --all --prefix="$staged_snapshot/"
# Git executes the checkout hook, while the proposed commit may contain an older protocol.
# Let that captured hook drive its matching captured executable.
if [[ -f "$staged_snapshot/.githooks/pre-commit" ]]; then
    checkout_hook=$(git hash-object --no-filters -- "${BASH_SOURCE[0]}")
    captured_hook=$(git hash-object --no-filters -- "$staged_snapshot/.githooks/pre-commit")
    if [[ "$checkout_hook" != "$captured_hook" ]]; then
        bash "$staged_snapshot/.githooks/pre-commit" "$@"
        exit $?
    fi
fi
GIT_INDEX_FILE="$snapshot_index" git -C "$repository_root" diff --cached --check

for required_path in workbench/config.toml workbench/projects.toml; do
    if [[ ! -f "$staged_snapshot/$required_path" ]]; then
        printf 'workbench: cannot check proposed commit:\n  %s is missing from the staged tree.\n' "$required_path" >&2
        printf '  Stage the project configuration and required project files before committing.\n  Unstaged and untracked files are excluded from commit checks.\n' >&2
        exit 1
    fi
done

if git -C "$repository_root" grep -n -I -E '^(<<<<<<<|=======|>>>>>>>)( |$)' "$review_tree" --; then
    echo 'workbench: staged content contains an unresolved merge marker' >&2
    exit 1
else
    scan_status=$?
    if [[ "$scan_status" != 1 ]]; then
        echo 'workbench: could not inspect staged content for merge markers' >&2
        exit "$scan_status"
    fi
fi
if [[ -f "$staged_snapshot/bin/workbench.mjs" ]]; then
    snapshot_launcher=(node "$staged_snapshot/bin/workbench.mjs")
elif command -v workbench >/dev/null 2>&1; then
    snapshot_launcher=(workbench)
else
    printf '%s\n' 'workbench: pre-commit requires Workbench on PATH.' \
        '  Follow the project README or see:' \
        "  https://github.com/greghogan/workbench/blob/main/docs/installations.md" >&2
    exit 1
fi
if ! command -v node >/dev/null 2>&1; then
    printf '%s\n' 'workbench: pre-commit requires Node.js on PATH.' \
        "  See https://github.com/greghogan/workbench/blob/main/docs/installations.md" >&2
    exit 1
fi
verify_staged=./verify-staged.mjs
if [[ "${BASH_SOURCE[0]}" == */* ]]; then
    verify_staged="${BASH_SOURCE[0]%/*}/verify-staged.mjs"
fi
if [[ -f "$staged_snapshot/.githooks/verify-staged.mjs" ]]; then
    verify_staged="$staged_snapshot/.githooks/verify-staged.mjs"
fi
cp -- "$verify_staged" "$snapshot_owner/verify-staged.mjs"
if [[ -f "$staged_snapshot/scripts/setup-development.mjs" ]]; then
    bash "$staged_snapshot/.githooks/prepare-source" "$repository_root" "$staged_snapshot"
fi
local_config_root=$(cd -- "$repository_root" && node -p 'process.cwd()')
export WORKBENCH_PROJECT_ROOT="$staged_snapshot"
export WORKBENCH_EPHEMERAL_CHECKOUT=1 WORKBENCH_LOCAL_CONFIG_ROOT="$local_config_root"
export WORKBENCH_REVIEW_TREE="$review_tree"
WORKBENCH_STAGED_INDEX=$(node -p 'require("node:path").resolve(process.argv[1])' "$snapshot_index")
export WORKBENCH_STAGED_INDEX
unset WORKBENCH_STAGED_SOURCE
launcher=()
if command -v bwrap >/dev/null 2>&1 && [[ "$(uname -s)" == Linux ]]; then
    # Only this hook owns the original checkout. Keep it read-only inside the gate and let unscoped
    # setup write into a disposable overlay at the normal checkout path.
    staged_source=$(mktemp -d)
    namespace=(bwrap --unshare-user --die-with-parent --dev-bind / /
        --ro-bind "$staged_snapshot" "$staged_source"
        --overlay-src "$staged_snapshot" --tmp-overlay "$staged_snapshot")
    if "${namespace[@]}" -- /bin/true >/dev/null 2>&1; then
        launcher=("${namespace[@]}" --setenv WORKBENCH_STAGED_SOURCE "$staged_source" --)
    fi
fi
# The child shell expands its own positional arguments and variables.
# shellcheck disable=SC2016
"${launcher[@]}" bash -e -c '
    verifier=$1 repository=$2 snapshot=$3 index=$4 tree=$5
    shift 5
    node "$verifier" "$repository" "$snapshot" "$index" "$tree"
    "$@" pre-commit "$snapshot"
    node "$verifier" "$repository" "$snapshot" "$index" "$tree"
' workbench "$snapshot_owner/verify-staged.mjs" "$repository_root" "$staged_snapshot" "$snapshot_index" "$review_tree" "${snapshot_launcher[@]}"
if ! git -C "$repository_root" diff --cached --quiet "$review_tree" --; then
    printf 'workbench: staged content changed during the commit gate.\n  Review and check the new snapshot.\n' >&2
    exit 1
fi
