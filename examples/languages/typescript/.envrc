PATH_add ../../../bin

# >>> Workbench direnv >>>
if command -v workbench >/dev/null 2>&1; then
    _workbench_exports=$(workbench paths --direnv) || exit
    eval "$_workbench_exports"
    unset _workbench_exports
fi
# <<< Workbench direnv <<<

watch_file .envrc.local
source_env_if_exists .envrc.local
