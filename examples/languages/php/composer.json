{
  "name": "workbench/php-reference",
  "description": "Workbench PHP reference",
  "license": "Apache-2.0",
  "type": "library",
  "require": {
    "php": ">=8.2.34"
  },
  "require-dev": {
    "workbench/verified-composer": "1.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": ".composer/verify",
      "options": {
        "symlink": false
      }
    }
  ],
  "config": {
    "platform": {
      "php": "8.2.34"
    },
    "allow-plugins": {
      "workbench/verified-composer": true
    },
    "preferred-install": "dist",
    "sort-packages": true,
    "source-fallback": false
  },
  "autoload": {
    "psr-4": {
      "WorkbenchReference\\": "src/"
    }
  },
  "bin": [
    "bin/count"
  ]
}
