;; Generated by scripts/managed-inputs.mjs; source identities come from the language locks.
(use-modules (guix packages) (guix gexp) (guix download) (guix base64) (guix utils)
             (guix build-system trivial) (guix profiles) (guix search-paths)
             ((guix licenses) #:prefix license:) (json) (srfi srfi-1))

(define declaration
  (string-append (dirname (current-filename)) "/managed-check-inputs.json"))
(define platform
  (cond ((string=? (%current-system) "x86_64-linux") "linux-x64")
        ((string=? (%current-system) "aarch64-linux") "linux-arm64")
        (else (error "managed check inputs require native Linux x64 or ARM64"))))
(define entries
  (filter (lambda (entry)
            (let ((platforms (assoc-ref entry "platforms")))
              (or (not platforms) (member platform (vector->list platforms)))))
          (vector->list (assoc-ref (call-with-input-file declaration json->scm) "inputs"))))
(define sources
  (map (lambda (entry)
         (let* ((integrity (assoc-ref entry "hash"))
                (separator (string-index integrity #\-))
                (algorithm (substring integrity 0 separator)))
           (origin
             (method url-fetch)
             (uri (assoc-ref entry "url"))
             (file-name (string-map (lambda (character) (if (char=? character #\@) #\_ character))
                                    (basename (assoc-ref entry "destination"))))
             (hash
              (let ((bytes (base64-decode (substring integrity (+ separator 1)))))
                (cond ((string=? algorithm "sha256") (content-hash bytes sha256))
                      ((string=? algorithm "sha512") (content-hash bytes sha512))
                      (else (error "unsupported managed source hash" algorithm))))))))
       entries))

(package
  (name "workbench-check-inputs")
  (version "1")
  (source #f)
  (build-system trivial-build-system)
  (arguments
   (list #:modules '((guix build utils))
         #:builder
         #~(begin
             (use-modules (guix build utils))
             (let ((directory (string-append #$output "/share/workbench/check-inputs")))
               (mkdir-p directory)
               (copy-file #$(local-file declaration) (string-append directory "/manifest.json"))
               #$(if (assoc-ref (call-with-input-file declaration json->scm) "bootstrap")
                     #~(copy-file #$(local-file (string-append (dirname declaration) "/managed-bootstrap.json"))
                                  (string-append directory "/bootstrap.json"))
                     #~#t)
               #$(if (assoc-ref (call-with-input-file declaration json->scm) "registry")
                     #~(copy-file #$(local-file (string-append (dirname declaration) "/managed-registry.json.br"))
                                  (string-append directory "/registry.json.br"))
                     #~#t)
               (for-each
                (lambda (destination source)
                  (let ((target (string-append directory "/" destination)))
                    (mkdir-p (dirname target))
                    (symlink source target)))
                '#$(map (lambda (entry) (assoc-ref entry "destination")) entries)
                (list #$@sources))))))
  (native-search-paths
   (list (search-path-specification
          (variable "WORKBENCH_CHECK_INPUTS")
          (files '("share/workbench/check-inputs"))
          (separator #f))))
  (synopsis "Locked sources for project checks")
  (description "Verified dependency sources declared by this project's language locks.")
  (home-page "https://github.com/greghogan/workbench")
  (license license:asl2.0))
