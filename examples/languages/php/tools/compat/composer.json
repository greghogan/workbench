{
  "name": "workbench/php-compat-tools",
  "description": "Workbench PHP reference",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.2.34"
  },
  "require-dev": {
    "workbench/verified-composer": "1.0.0",
    "phpunit/phpunit": "11.5.57",
    "brianium/paratest": "7.8.6"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../.composer/verify",
      "options": {
        "symlink": false
      }
    }
  ],
  "config": {
    "platform": {
      "php": "8.2.34"
    },
    "allow-plugins": {
      "workbench/verified-composer": true
    },
    "preferred-install": "dist",
    "sort-packages": true,
    "source-fallback": false
  }
}
