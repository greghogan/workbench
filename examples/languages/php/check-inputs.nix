# Generated by scripts/managed-inputs.mjs; source identities come from the language locks.
{ pkgs }:
let
  declaration = builtins.fromJSON (builtins.readFile ./managed-check-inputs.json);
  platform = if pkgs.stdenv.hostPlatform.isx86_64 then "linux-x64"
    else if pkgs.stdenv.hostPlatform.isAarch64 then "linux-arm64"
    else throw "managed check inputs require native Linux x64 or ARM64";
  entries = builtins.filter (entry: !(entry ? platforms) || builtins.elem platform entry.platforms) declaration.inputs;
  source = entry: pkgs.fetchurl {
    inherit (entry) url hash;
    name = builtins.replaceStrings [ "@" ] [ "_" ] (builtins.baseNameOf entry.destination);
  };
in pkgs.runCommand "workbench-check-inputs" {} ''
  mkdir -p "$out/share/workbench/check-inputs" "$out/nix-support"
  cp ${./managed-check-inputs.json} "$out/share/workbench/check-inputs/manifest.json"
  ${pkgs.lib.optionalString (declaration.bootstrap or false) ''
    cp ${./managed-bootstrap.json} "$out/share/workbench/check-inputs/bootstrap.json"
  ''}
  ${pkgs.lib.optionalString (declaration.registry or false) ''
    cp ${./managed-registry.json.br} "$out/share/workbench/check-inputs/registry.json.br"
  ''}
  ${pkgs.lib.concatMapStringsSep "\n" (entry: ''
    mkdir -p "$out/share/workbench/check-inputs/${builtins.dirOf entry.destination}"
    ln -s ${source entry} "$out/share/workbench/check-inputs/${entry.destination}"
  '') entries}
  echo "export WORKBENCH_CHECK_INPUTS=$out/share/workbench/check-inputs" > "$out/nix-support/setup-hook"
''
