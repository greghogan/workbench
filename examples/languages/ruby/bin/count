#!/usr/bin/env ruby
# frozen_string_literal: true

require "workbench_ruby_reference"

begin
  raise ArgumentError, "expected BYTE and DATA" unless ARGV.length == 2

  puts WorkbenchRubyReference.count_byte(ARGV.fetch(1), Integer(ARGV.fetch(0), 10))
rescue ArgumentError, RangeError => e
  warn e.message
  exit 2
end
