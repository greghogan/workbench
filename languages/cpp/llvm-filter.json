  "revision": 2,
  "include": [
    "^bin/(?:clang|clang\\+\\+|clang\\-cl|clang\\-cpp|clang\\-format|clang\\-tidy|clangd|llvm\\-cov|llvm\\-profdata|llvm\\-ar|llvm\\-ranlib|llvm\\-nm|llvm\\-objcopy|llvm\\-strip|llvm\\-symbolizer|lld|ld\\.lld|lld\\-link|ld64\\.lld|clang-\\d+)(?:\\.exe)?$",
